# Copy this file to ".env" and fill in your own values.
# ".env" holds your real settings and must never be committed to GitHub (.gitignore already
# blocks it). This ".env.example" file is safe to commit: it contains no secrets.

# --- Required ---------------------------------------------------------------
# A long random string that signs login sessions. Create one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# development, testing or production
APP_ENV=development

# --- Optional ---------------------------------------------------------------
# Database location. Leave this commented out to use the default (instance/saferadar.db).
# DATABASE_URL=sqlite:///saferadar.db

# Routing service for the route planner (Phase 9).
# The public OSRM demo server is free and for light use only. It gives CAR routes only,
# so travel times are driving times.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# For WALKING routes, use a server that has a foot profile instead. Remove the "#" from
# these two lines and put "#" in front of the two OSRM lines above. That server is run by
# someone else, so test it before you rely on it.
# OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
# OSRM_PROFILE=foot